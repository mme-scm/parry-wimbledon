    "citation": "Il. 3.330 = 11.17 = 16.131 = 19.369",
    "homeric_occurrences": 4
   },
   {
    "n": 8,
    "text": "ἂν δ᾽ ἕλετ᾽ ἀμφιβρότην πολυδαίδαλον ἀσπίδα θοῦριν,",
    "section": "entry and arming",
    "citation": "Il. 11.32",
    "homeric_occurrences": 1
   },
   {
    "n": 9,
    "text": "εἵλετο δ᾽ ἄλκιμον ἔγχος, ὅ οἱ παλάμηφιν ἀρήρει.",
    "section": "entry and arming",
    "citation": "Il. 3.338 = Od. 17.4",
    "homeric_occurrences": 2
   },
   {
    "n": 11,
    "text": "καί ῥ᾽ ἐγγὺς στήτην διαμετρητῷ ἐνὶ χώρῳ.",
    "section": "entry and arming",
    "citation": "Il. 3.344",
    "homeric_occurrences": 1
   },
   {
    "n": 13,
    "text": "ἔνθά σφιν κατὰ ἶσα μάχην ἐτάνυσσε Κρονίων.",
    "section": "set 1",
    "citation": "Il. 11.336",
    "homeric_occurrences": 1
   },
   {
    "n": 16,
    "text": "ὡς δ᾽ ὅτε τις στατὸς ἵππος ἀκοστήσας ἐπὶ φάτνῃ",
